    },
    {
      "parameters": {
        "jsCode": "// Normalize the voice platform payload into one lead schema, then pick a route.\nconst body = $('Webhook').first().json.body || {};\nconst caller = body.caller || {};\nconst loc = body.service_location || {};\nconst req = body.request || {};\n\nconst lead = {\n  event_id: body.event_id || null,\n  call_id: body.call_id || null,\n  received_at: body.received_at || new Date().toISOString(),\n  name: (caller.name || '').trim(),\n  phone: (caller.phone || '').replace(/[^\\d+]/g, ''),\n  email: (caller.email || '').trim().toLowerCase(),\n  city: loc.city || '',\n  state: loc.state || '',\n  postal_code: loc.postal_code || '',\n  service: (req.service || '').trim(),\n  summary: (req.summary || '').trim(),\n  urgency: req.urgency || 'normal',\n  preferred_contact: req.preferred_contact || 'phone',\n  best_time: req.best_time || '',\n};\n\nlet route = 'qualified';\nlet reason = 'Contact details and service request present';\n\nif (!lead.event_id || !lead.phone) {\n  route = 'invalid';\n  reason = 'Missing event_id or caller phone';\n} else if (!lead.service || /(warranty|survey|robocall|solicit)/i.test(lead.summary)) {\n  route = 'junk';\n  reason = 'No service requested or looks like a sales call';\n}\n\nreturn [{ json: { route, reason, lead } }];"
      },
